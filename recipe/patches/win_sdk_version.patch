+def patch_win_sdk_version(win_sdk_dir):
+    # PDFium's vendored build/vs_toolchain.py and build/toolchain/win/setup_toolchain.py
+    # hardcode an exact Windows SDK version and pass it to vcvarsall.bat unconditionally
+    # in ambient-MSVC mode (DEPOT_TOOLS_WIN_TOOLCHAIN=0), independently of win_sdk_dir.
+    # Align that pin with whatever SDK is actually being used, taken from the version
+    # folder name in win_sdk_dir (".../bin/<version>/x64").
+    sdk_version = Path(win_sdk_dir).parent.name
+    for rel_path in ("vs_toolchain.py", "toolchain/win/setup_toolchain.py"):
+        fp = PDFiumDir_build / rel_path
+        text = fp.read_text()
+        patched = re.sub(r"SDK_VERSION = '[^']+'", f"SDK_VERSION = '{sdk_version}'", text)
+        fp.write_text(patched)
+
